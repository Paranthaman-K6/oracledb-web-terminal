# Database User
DB_USER=

# Database Password
DB_PASSWORD=

# Connection string to your Oracle instance
# Examples:
# - Easy Connect: host:port/service_name
# - Autonomous DB: mydb_high.adb.region.oraclecloud.com:1522/mydb.adb.oraclecloud.com
# - TNS Alias: MY_TNS_ALIAS
CONNECT_STRING=

# Oracle Wallet Password (If using a cloud wallet)
# WALLET_PASSWORD=

# Path to your Oracle Wallet directory (If using a cloud wallet)
# WALLET_LOCATION=./wallet

# Optional HTTP Proxy Settings
# HTTPS_PROXY=
# HTTPS_PROXY_PORT=